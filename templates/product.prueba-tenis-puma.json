            "custom_liquid": "<div style=\"display:flex;flex-direction:column;gap:1px;align-items:flex-start;margin-top:4px;\">\n  {% assign compare_price = product.compare_at_price | default: product.variants.first.compare_at_price %}\n  {% if compare_price and compare_price > product.price %}\n    <!-- Precio tachado (Antes) -->\n    <div style=\"font-size:14px;color:#999;text-decoration:line-through;font-weight:400;margin-bottom:-2px;\">\n      Antes: {{ compare_price | money }}\n    </div>\n  {% endif %}\n\n  <!-- Precio actual -->\n  <div style=\"font-size:26px;font-weight:900;color:#000;line-height:1.1;\">\n    {{ product.price | money }}\n  </div>\n\n  {% if compare_price and compare_price > product.price %}\n    {% assign ahorro = compare_price | minus: product.price %}\n    {% assign descuento = ahorro | times: 100 | divided_by: compare_price | round %}\n    <!-- Ahorro -->\n    <div style=\"background:#ffebee;border:1px solid #ff9a9a;color:#c81f13;padding:4px 6px;border-radius:6px;font-weight:700;font-size:13px;\">\n      Ahorras {{ ahorro | money }} (–{{ descuento }}%)\n    </div>\n  {% endif %}\n</div>"
