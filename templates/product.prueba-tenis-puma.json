        "custom_liquid_BkAQfA": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- Botón / Enlace para abrir -->\n<div id=\"openSizeGuide\" \n     style=\"display:inline-flex; align-items:center; gap:6px; cursor:pointer;\n            font-size:15px; font-weight:600; color:#1a73e8; padding:6px 10px;\n            border-radius:6px; background:#e8f0fe; transition:0.3s;\">\n  \n  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"#1a73e8\" viewBox=\"0 0 24 24\">\n    <path d=\"M20 6h-3V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v16h2a3 3 0 0 0 6 0h4a3 3 0 0 0 6 0h2V8a2 2 0 0 0-2-2zM7 20a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm10 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm2-6H7V6h12v8z\"/></svg>\n\n  Tabla de tallas\n</div>\n\n<!-- Overlay del popup -->\n<div id=\"sizeGuideModal\" \n     style=\"display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55);\n            z-index:9999999999999; justify-content:center; align-items:flex-start; padding:20px;\n            overflow-y:auto; -webkit-overflow-scrolling:touch;\">\n \n  <!-- Caja del popup -->\n  <div style=\"background:#fff; width:100%; max-width:420px; border-radius:14px;\n              padding:16px 18px; position:relative; animation:fadeInScale 0.25s ease;\n              box-shadow:0 10px 25px rgba(0,0,0,0.20); z-index:9999999999999;\n              margin:5vh auto;                  /* empuja hacia abajo desde el top */\n              max-height:calc(100vh - 40px);    /* limita altura al viewport */\n              overflow:auto;                    /* scroll interno cuando haga falta */\n              -webkit-overflow-scrolling:touch;\">\n\n    <!-- ❌ Botón cerrar -->\n    <div id=\"closeSizeGuide\"\n         style=\"position:absolute; right:12px; top:10px; cursor:pointer;\n                font-size:26px; font-weight:bold; color:#555;\n                width:36px; height:36px; display:flex; align-items:center;\n                justify-content:center; border-radius:50%;\n                transition:0.12s; box-shadow: 0 2px 6px rgba(0,0,0,0.08); background:transparent;\"\n         onmouseover=\"this.style.background='#f2f2f2'\"\n         onmouseout=\"this.style.background='transparent'\">\n      &times;\n    </div>\n\n    <h2 style=\"font-size:18px; margin:10px 0 14px; color:#111; font-weight:700; text-align:center;\">\n      Guía de tallas\n    </h2>\n\n    <!-- Imagen ajustada para no recortarse -->\n    <img src=\"https://cdn.shopify.com/s/files/1/0633/5856/6463/files/tallascloudstriker.webp?v=1763601422\"\n         alt=\"Guía de tallas\"\n         style=\"width:100%; height:auto; display:block; border-radius:10px;\n                object-fit:contain; max-height:70vh;\">\n\n    <!-- (Opcional) pie o contenido extra -->\n    <!-- <p style=\"font-size:13px; color:#666; text-align:center; margin-top:10px;\">Instrucciones para medir...</p> -->\n\n  </div>\n</div>\n\n<!-- Animación -->\n<style>\n@keyframes fadeInScale {\n  0% {opacity:0; transform:scale(0.96);}\n  100% {opacity:1; transform:scale(1);}\n}\n\n/* Scrollbar fino opcional (solo visual) */\n#sizeGuideModal > div::-webkit-scrollbar { width:8px; }\n#sizeGuideModal > div::-webkit-scrollbar-thumb { background:rgba(0,0,0,0.12); border-radius:6px; }\n</style>\n\n<!-- JS -->\n<script>\n(function(){\n  var openBtn = document.getElementById(\"openSizeGuide\");\n  var modal = document.getElementById(\"sizeGuideModal\");\n  var closeBtn = document.getElementById(\"closeSizeGuide\");\n\n  openBtn && openBtn.addEventListener(\"click\", function(){\n    modal.style.display = \"flex\";\n    // intenta forzar que body no oculte overflow si el theme lo hace (opcional)\n    try { document.body.style.overflow = 'hidden'; } catch(e) {}\n  });\n\n  closeBtn && closeBtn.addEventListener(\"click\", function(){\n    modal.style.display = \"none\";\n    try { document.body.style.overflow = ''; } catch(e) {}\n  });\n\n  modal && modal.addEventListener(\"click\", function(e){\n    if (e.target === modal) {\n      modal.style.display = \"none\";\n      try { document.body.style.overflow = ''; } catch(e) {}\n    }\n  });\n\n  // se cierra con ESC\n  document.addEventListener(\"keydown\", function(e){\n    if (e.key === \"Escape\" && modal.style.display === \"flex\") {\n      modal.style.display = \"none\";\n      try { document.body.style.overflow = ''; } catch(e) {}\n    }\n  });\n})();\n</script>"
