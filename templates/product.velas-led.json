    "custom_liquid_dpVgT8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div>\n    <style>\n  #popup-postura {\n    position: fixed;\n    top: 20px;\n    left: 50%;\n    transform: translateX(-50%);\n    display: none;\n    align-items: center;\n    background-color: #f2f2f2;\n    color: #000;\n    padding: 10px 18px;\n    border-radius: 12px;\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);\n    z-index: 9999;\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    font-size: 13px;\n    animation: fadeIn 0.3s ease-in-out;\n    width: 280px;\n    gap: 12px;\n  }\n\n  #popup-postura img {\n    width: 42px;\n    height: 42px;\n    border-radius: 8px;\n    object-fit: cover;\n    flex-shrink: 0;\n  }\n\n  #popup-text {\n    line-height: 1.4;\n    font-weight: 400;\n    color: #000;\n    word-wrap: break-word;\n  }\n\n  #popup-text .name {\n    color: #1877f2;\n    font-weight: 600;\n    display: inline-flex;\n    align-items: center;\n  }\n\n  .verified-icon {\n    display: inline-block;\n    margin-left: 5px;\n    vertical-align: middle;\n  }\n\n  .city {\n    color: #000;\n  }\n\n  .product {\n    font-weight: 500;\n  }\n\n  .time {\n    color: #999;\n    font-size: 12px;\n    font-style: italic;\n  }\n\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(-10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n</style>\n\n<div id=\"popup-postura\" style=\"display: none;\">\n  <img id=\"popup-img\" src=\"https://cdn.shopify.com/s/files/1/0633/5856/6463/files/S82b22ba20bd14f9e96f3b681f431b4cbQ_jpg_960x960q75_jpg.avif?v=1761435305\" alt=\"Producto\">\n  <div id=\"popup-text\">\n        <strong class=\"name\">\n          Valeria Rodríguez\n          <span class=\"verified-icon\" aria-label=\"Verificado\" role=\"img\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" fill=\"#1877f2\" width=\"16\" height=\"16\">\n              <circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"#1877f2\"></circle>\n              <path d=\"M6.8 10.4L4.6 8.2l-.8.8 3 3 5-5-.8-.8z\" fill=\"#fff\"></path>\n            </svg>\n          </span>\n        </strong> compró <strong class=\"product\">X2 Helicoptero a control AeroFly</strong> en <span class=\"city\">Ibagué</span><span class=\"time\"> — hace 1 minuto</span>\n      </div>\n</div>\n\n<audio id=\"popup-sound\" preload=\"auto\">\n  <source src=\"https://cdn.pixabay.com/audio/2022/03/15/audio_4db5cf1ee4.mp3\" type=\"audio/mpeg\">\n</audio>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const mujeres = [\n      \"Valeria Rodríguez\", \"Daniela Gómez\", \"Camila Herrera\",\n      \"Sofía Morales\", \"Mariana Cruz\", \"Paula Jiménez\",\n      \"Natalia Salazar\", \"Isabela Ríos\", \"Laura Martínez\", \"Andrea Vargas\"\n    ];\n\n    const municipios = [\n      \"Soacha\", \"Chía\", \"Envigado\", \"Itagüí\", \"Pereira\",\n      \"Rionegro\", \"Cúcuta\", \"Ibagué\", \"Villavicencio\", \"Bucaramanga\",\n      \"Palmira\", \"Tunja\", \"Girardot\", \"Sabaneta\", \"Yumbo\"\n    ];\n\n    const tiempos = [\"Ahora\", \"1 minuto\", \"2 minutos\", \"3 minutos\"];\n\n    const popup = document.getElementById(\"popup-postura\");\n    const texto = document.getElementById(\"popup-text\");\n    const sonido = document.getElementById(\"popup-sound\");\n\n    let lastIndex = -1;\n\n    function getRandomIndexExcept(length, except) {\n      let index = Math.floor(Math.random() * length);\n      while (index === except) index = Math.floor(Math.random() * length);\n      return index;\n    }\n\n    function mostrarPopup() {\n      const index = getRandomIndexExcept(mujeres.length, lastIndex);\n      lastIndex = index;\n\n      const nombre = mujeres[index];\n      const ciudad = municipios[Math.floor(Math.random() * municipios.length)];\n      const tiempo = tiempos[Math.floor(Math.random() * tiempos.length)];\n      const tiempoTexto = tiempo === \"Ahora\" ? tiempo : `hace ${tiempo}`;\n\n      texto.innerHTML = `\n        <strong class=\"name\">\n          ${nombre}\n          <span class=\"verified-icon\" aria-label=\"Verificado\" role=\"img\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" fill=\"#1877f2\" width=\"16\" height=\"16\">\n              <circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"#1877f2\"/>\n              <path d=\"M6.8 10.4L4.6 8.2l-.8.8 3 3 5-5-.8-.8z\" fill=\"#fff\"/>\n            </svg>\n          </span>\n        </strong> compró <strong class=\"product\">{{product.title}}</strong> en <span class=\"city\">${ciudad}</span><span class=\"time\"> — ${tiempoTexto}</span>\n      `;\n\n      popup.style.display = \"flex\";\n      sonido.currentTime = 0;\n      sonido.play();\n\n      setTimeout(() => {\n        popup.style.display = \"none\";\n      }, 7000);\n    }\n\n    setTimeout(() => {\n      mostrarPopup();\n      setInterval(mostrarPopup, 25000);\n    }, 3000);\n  });\n</script>\n    </div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
